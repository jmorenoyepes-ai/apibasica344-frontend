<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body class="container">


    <header>
        <%- include('../partials/header'); %>
    </header>


    <main>
        <div class="jumbotron">
            <div class="container mt-3">
                <h2>Registrar cliente</h2>
                <form action="/clientes" method="post">
                    <div class="mb-3 mt-3">
                        <label for=""><%=mensaje%></label><br>
                        <label for="nombre">Nombre:</label>
                        <input type="text" class="form-control" id="nombre" placeholder="Ingresa tu nombre" name="nombre">
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="email">Email:</label>
                        <input type="email" class="form-control" id="email" placeholder="Ingresa tu email" name="email">
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="tel">Tel:</label>
                        <input type="text" class="form-control" id="tel" placeholder="Ingresa tu telefono" name="telefono">
                    </div>

                    <button type="submit" class="btn btn-primary">Registrar</button>
                </form>
            </div>

        </div>
    </main>
    <footer>
        <%- include('../partials/footer'); %>
    </footer>
</body>

</html>