<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
</head>
<body class="container">

    <header>
        <%- include('../partials/header'); %>
    </header>

    <main>
       <div class="jumbotron">
           <h1>Productos</h1>
           <table id="tablita" class="table table-striped">
               <thead>
                   <th>Nombre</th>
                   <th>Precio</th>
                   <th>Stock</th>
                   <th>Acciones</th>
               </thead>
               <tbody >
                   <% productos.forEach(function(producto) { %>
                   <tr>
                       <td><%=producto.nombre%></td>
                       <td><%=producto.precio%></td>
                       <td><%=producto.stock%></td>
                       <td>
                            <a class="btn btn-outline-info" href="">Ver detalles</a>
                            <a class="btn btn-outline-warning" href="">Editar</a>
                            <a class="btn btn-outline-danger" href="">Eliminar</a>
                       </td>
                   </tr>
               <% }); %>
               </tbody>

           </table>

       </div>
   </main>
            </ul>
        </div>
    </main>

    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    
</body>
</html>